# Copy this file to .env and fill in your values before running install.sh
# cp .env.example .env

# Notion: create an integration at https://www.notion.so/profile/integrations
# then share the pages/databases you want Claude to access with the integration
NOTION_API_TOKEN=

# Linear: generate an API key at https://linear.app/settings/api
LINEAR_API_KEY=

# Google Workspace (personal) MCP — Gmail + Calendar. Your personal Google
# address; used as the default account in single-user mode.
USER_GOOGLE_EMAIL=

# Setup steps for the Google Workspace MCP:
# 1. Create project + enable BOTH the Gmail API and the Google Calendar API at
#    https://console.cloud.google.com/
# 2. APIs & Services > Credentials > Create OAuth client ID > Desktop app
# 3. Download JSON, rename to ./gmail-oauth.keys.json at the repo root (gitignored)
# 4. On the OAuth client, add the redirect URI: http://localhost:8000/oauth2callback
# 5. Set USER_GOOGLE_EMAIL above, then run install.sh. First tool use opens the
#    browser to authorize (Gmail + Calendar scopes).
